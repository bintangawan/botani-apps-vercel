# -----------------------------------------------------------------------------
# BOTANI - LOCAL / VERCEL ENVIRONMENT
# Copy file ini menjadi .env.local. Jangan commit nilai rahasia ke Git.
# -----------------------------------------------------------------------------

# URL aplikasi tanpa trailing slash.
# Di Vercel ubah menjadi https://domain-anda.vercel.app atau custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Dashboard -> tombol Connect (Project URL dan Publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Supabase Dashboard -> Project Settings -> API Keys -> Secret keys.
# Server-only: JANGAN pernah memakai prefix NEXT_PUBLIC_ untuk nilai ini.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Supabase Dashboard -> tombol Connect -> Connection string.
# DATABASE_URL: Transaction pooler (port 6543), dipakai Drizzle saat runtime Vercel.
# DIRECT_URL: Direct connection atau Session pooler (port 5432), dipakai migration.
# Ganti placeholder, URL-encode password, dan pertahankan sslmode=require.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_DATABASE_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Bucket dibuat otomatis oleh npm run db:seed dan digunakan oleh Storage policy.
NEXT_PUBLIC_STORAGE_BUCKET=plant-images

# Opsional/cadangan saja: pg_cron langsung di Supabase tidak memakai token ini.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# -----------------------------------------------------------------------------
# SEED AKUN AWAL
# Digunakan hanya oleh npm run db:seed:users, tidak dibaca saat runtime aplikasi.
# Password minimal 8 karakter. Institution boleh dikosongkan, tetapi variabelnya
# tetap harus dicantumkan. Seed aman dijalankan ulang untuk menyelaraskan akun.
# -----------------------------------------------------------------------------

SEED_MAHASISWA_NAME=
SEED_MAHASISWA_EMAIL=
SEED_MAHASISWA_PASSWORD=
SEED_MAHASISWA_INSTITUTION=

SEED_DOSEN_NAME=
SEED_DOSEN_EMAIL=
SEED_DOSEN_PASSWORD=
SEED_DOSEN_INSTITUTION=

SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_INSTITUTION=
